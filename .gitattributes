# Store and check out text files with LF; Windows batch files need CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert line endings or diff as text.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.db binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
*.zip binary
*.pdf binary
