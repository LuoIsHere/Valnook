    <string name="ai_guide_check_title">保存与检测</string>
    <string name="ai_guide_check_body">填写完成后，点击“保存并检测”。检测会向服务方发送几次很小的请求，可能产生少量费用。</string>
    <string name="ai_guide_check_required">连通、工具调用：必须通过，才能启用 AI 功能。</string>
